<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<base href="/" />
	<ResourcePreloader />
	<link href="_content/Microsoft.FluentUI.AspNetCore.Components/css/reboot.css" rel="stylesheet" />

	<link rel="stylesheet" href="@Assets["css/tokens.css"]" />
	<link rel="stylesheet" href="@Assets["css/app.css"]" />
	<link rel="stylesheet" href="@Assets["MmgExplorer.styles.css"]" />
	<ImportMap />
	<HeadOutlet />
</head>

<body use-reboot>
	<Routes @rendermode="InteractiveServer" />
	<ReconnectModal />
	<script src="@Assets["_framework/blazor.web.js"]"></script>
	<script>
		window.sidebarBreakpoint = {
		init(dotNetRef, maxWidth) {
		const mql = window.matchMedia(`(max-width: ${maxWidth}px)`);
		dotNetRef.invokeMethodAsync('OnBreakpointChanged', mql.matches);
		mql.addEventListener('change', e => dotNetRef.invokeMethodAsync('OnBreakpointChanged', e.matches));
		}
		};
		window.messageViewer = {
		scrollToSegment(domId) {
		const el = document.getElementById(domId);
		if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
		}
		};
	</script>
</body>

</html>
