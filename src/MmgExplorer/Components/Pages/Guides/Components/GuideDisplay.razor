<div class="guide-display">
    <FluentGrid Justify="JustifyContent.SpaceEvenly" Spacing="3" AdaptiveRendering="true">
        <FluentGridItem Xs="12" Sm="12" Md="12">
            <FluentText As="TextTag.H1" Block="true" Align="TextAlign.Start">
                Guide (@Guide?.Name)
            </FluentText>
            <FluentText As="TextTag.Paragraph" Block="true" Align="TextAlign.Justify" Color="Color.Disabled"
                        Class="@(descriptionExpanded ? "guide-description expanded" : "guide-description")">
                @Guide?.Description
            </FluentText>
            @if (Guide?.Description?.Length > 240)
            {
                <FluentButton Appearance="ButtonAppearance.Transparent" Size="ButtonSize.Small" OnClick="ToggleDescription">
                    @(descriptionExpanded ? "Show less" : "Show more")
                </FluentButton>
            }
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6" Md="4">
            <FluentCard Appearance="CardAppearance.Filled" Height="100%" Shadow="CardShadow.Large">
                <FluentStack Orientation="Orientation.Horizontal" VerticalGap="8px" Width="100%" HorizontalAlignment="HorizontalAlignment.SpaceBetween">
                    <h3>Blocks</h3>
                    <h4>@Guide?.Blocks.Count()</h4>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6" Md="4">
            <FluentCard Appearance="CardAppearance.Filled" Height="100%" Shadow="CardShadow.Large">
                <FluentStack Orientation="Orientation.Horizontal" VerticalGap="8px" Width="100%" HorizontalAlignment="HorizontalAlignment.SpaceBetween">
                    <h3>Elements</h3>
                    <h4>@Guide?.Blocks.SelectMany(b => b.Elements).Count()</h4>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6" Md="4">
            <FluentCard Appearance="CardAppearance.Default" Height="100%" Shadow="CardShadow.Large">
                <FluentStack Orientation="Orientation.Horizontal" VerticalGap="8px" Width="100%" HorizontalAlignment="HorizontalAlignment.SpaceBetween">
                    <h3>ValueSets</h3>
                    <h4 style="color: var(--brand-accent-orange);">@Guide?.ValueSets?.Count()</h4>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="12" Md="12">
            <FluentAccordion Block="true"
                             HeadingLevel="1"
                             ExpandMode="AccordionExpandMode.Single"
                             Size="AccordionItemSize.Medium"
                             ActiveId="@activeId"
                             OnAccordionItemChange="HandleOnAccordionItemChange">
                @foreach (var block in Guide?.Blocks)
                {
                    <FluentAccordionItem Block="true"
                                         Header="@($"{block.Name} Elements: {block.Elements.Count()}")"
                                         Size="AccordionItemSize.Medium"
                                         HeadingLevel="2"
                                         Id="@($"{block.Id}")"
                                         MarkerPosition="AccordionItemMarkerPosition.End">
                        <FluentText As="TextTag.Paragraph" Block="true" Align="TextAlign.Justify">
                            @block.StartingDescription
                            <FluentBadge Color="BadgeColor.Brand">Expanded: @block.Expanded</FluentBadge>
                            <FluentBadge Color="BadgeColor.Danger">Ordinal @block.Ordinal</FluentBadge>
                            <FluentBadge Color="BadgeColor.Important">Short Name: @block.ShortName</FluentBadge>
                            <FluentBadge Color="BadgeColor.Informative">Should Display Name: @block.ShouldDisplayName</FluentBadge>
                            <FluentBadge Color="BadgeColor.Severe">Template: @block.Template</FluentBadge>
                            <FluentBadge Color="BadgeColor.Subtle">Subtle</FluentBadge>
                            <FluentBadge Color="BadgeColor.Success">Success</FluentBadge>
                            <FluentBadge Color="BadgeColor.Warning">Warning</FluentBadge>

                        </FluentText>
                        <FluentGrid Justify="JustifyContent.SpaceEvenly" Spacing="3" AdaptiveRendering="true">
                            @foreach (var element in block.Elements)
                            {
                                <FluentGridItem Xs="12" Sm="6" Md="4">
                                    <FluentCard Appearance="CardAppearance.Outline" Height="100%" Shadow="CardShadow.Medium">
                                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8px" Padding="16px">
                                            <h4>@element.Name</h4>
                                            <p>@element.Description</p>
                                            @if (element.ValueSetCode != null)
                                            {
                                                <FluentBadge Color="BadgeColor.Brand">@($"ValueSet: {element.ValueSetCode}")</FluentBadge>
                                            }
                                        </FluentStack>
                                    </FluentCard>
                                </FluentGridItem>
                            }
                        </FluentGrid>
                        <FluentText As="TextTag.Paragraph" Block="true" Align="TextAlign.Justify">
                            @block.EndingDescription
                        </FluentText>
                    </FluentAccordionItem>
                }
            </FluentAccordion>
        </FluentGridItem>
    </FluentGrid>
</div>

