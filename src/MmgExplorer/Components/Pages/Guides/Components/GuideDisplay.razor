<h3>Guide (@Guide?.Name)</h3>
<p>@Guide?.Description</p>
<FluentGrid Spacing="3" AdaptiveRendering="true">
    <FluentGridItem Xs="12" Sm="6" Md="4">
        <FluentCard Appearance="CardAppearance.Filled">
            <h3>Blocks</h3>
            <h4>@Guide?.Blocks.Count()</h4>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem Xs="12" Sm="6" Md="4">
        <FluentCard Appearance="CardAppearance.Filled">
            <h3>Elements</h3>
            <h4>@Guide?.Blocks.SelectMany(b => b.Elements).Count()</h4>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem Xs="12" Sm="6" Md="4">
        <FluentCard Appearance="CardAppearance.Filled">
            <h3>ValueSets</h3>
            <h4>@Guide?.ValueSets?.Count()</h4>
        </FluentCard>
    </FluentGridItem>
</FluentGrid>

@code {

}
