@page "/"

@using MmgExplorer.Components.UI.Tables.Models
@using MmgExplorer.Models

<PageTitle>Home · MMG Explorer</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="24">
    <div class="table-page">
        <div class="table-content-layout">
            <div class="table-main">
                <Card Title="Guides" SubTitle="@($"Total Guides: ${records?.Count() ?? 0}")" TableLayout="true">
                    <FluentCustomizableTable IsLoading="loading"
                                             TItem="Guide"
                                             Items="@(records.AsQueryable())"
                                             ObjectName="Guide"
                                             ObjectNamePlural="Guides"
                                             Columns="@columns"
                                             ToolbarConfig="tableToolbarConfig"
                                             OnToggleColumns="ToggleColumnsPanel"
                                             OnToggleFilters="ToggleFiltersPanel" />
                </Card>
            </div>
        </div>
    </div>
    <div>
        <h1 style="margin: 0 0 var(--space-xs); font-size: var(--type-title-1); font-weight: 700;">
            Welcome
        </h1>
        <p style="margin: 0; color: var(--color-fg-secondary); font-size: var(--type-subtitle-2);">
            Here's what's happening across your workspace today.
        </p>
    </div>

    <FluentGrid Spacing="3">
        <FluentGridItem Xs="12" Xxl="6" Xl="12" Lg="12" Sm="12" Md="12">
            <FluentCustomizableTable IsLoading="loading"
                                     TItem="Guide"
                                     Items="@(records.AsQueryable())"
                                     ObjectName="Guide"
                                     ObjectNamePlural="Guides"
                                     Columns="@columns"
                                     ToolbarConfig="tableToolbarConfig"
                                     OnToggleColumns="ToggleColumnsPanel"
                                     OnToggleFilters="ToggleFiltersPanel" />
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" md="3">
            <FluentCard Style="padding: var(--space-l); border-radius: var(--radius-l);">
                <div style="color: var(--color-fg-secondary); font-size: var(--type-caption); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;">Guides</div>
                <div style="font-size: var(--type-display); font-weight: 700; color: var(--color-brand-primary); line-height: 1;">@(records?.Count() ?? 0)</div>
                @* <div style="color: var(--color-trend-positive); font-size: var(--type-caption); font-weight: 600;">▲ 3 this week</div> *@
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" md="3">
            <FluentCard Style="padding: var(--space-l); border-radius: var(--radius-l);">
                <div style="color: var(--color-fg-secondary); font-size: var(--type-caption); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;">In Review</div>
                <div style="font-size: var(--type-display); font-weight: 700; color: var(--color-brand-secondary); line-height: 1;">0</div>
                @* <div style="color: var(--color-fg-muted); font-size: var(--type-caption); font-weight: 600;">awaiting approval</div> *@
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" md="3">
            <FluentCard Style="padding: var(--space-l); border-radius: var(--radius-l);">
                <div style="color: var(--color-fg-secondary); font-size: var(--type-caption); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;">Updated</div>
                <div style="font-size: var(--type-display); font-weight: 700; color: var(--color-brand-accent); line-height: 1;">0</div>
                @* <div style="color: var(--color-trend-positive); font-size: var(--type-caption); font-weight: 600;">▲ 12% MoM</div> *@
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" md="3">
            <FluentCard Style="padding: var(--space-l); border-radius: var(--radius-l);">
                <div style="color: var(--color-fg-secondary); font-size: var(--type-caption); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;">Team</div>
                <div style="font-size: var(--type-display); font-weight: 700; color: var(--color-fg-default); line-height: 1;">3</div>
                <div style="color: var(--color-fg-muted); font-size: var(--type-caption); font-weight: 600;">contributors online</div>
            </FluentCard>
        </FluentGridItem>
    </FluentGrid>

    <FluentCard Style="padding: var(--space-xl); border-radius: var(--radius-l);">
        <h2 style="margin: 0 0 var(--space-s); font-size: var(--type-title-3);">Recent activity</h2>
        <p style="margin: 0; color: var(--color-fg-secondary);">
            Your specs, commits, and reviews will surface here as the project grows.
        </p>
    </FluentCard>
</FluentStack>

@code {
    void SetColumns()
    {
        columns = new List<TableColumn<Guide>>
        {
            TableColumn<Guide>.Create("Id", x => x.Id, sortable: true),
            TableColumn<Guide>.Create("Name", x => x.Name, sortable: true),
            TableColumn<Guide>.Create("Publish Date", x => x.PublishDate, sortable: true),
        };
    }
}