@page "/"
@inject IDialogService DialogService
@* Apply an "interactive" render mode, or set the render mode globally for all routes *@
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>Welcome</h1>

<p>Message Mapping Guide Explorer is an app that retrieves Message Mapping Guides that are put out from the <FluentLink Href="https://ndc.services.cdc.gov/implementation-guides/" Appearance="LinkAppearance.Default">CDC</FluentLink> </p>

Welcome to your new app.
<FluentStack Orientation="Orientation.Vertical">
    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@IncrementCountAsync">
        Click me
    </FluentButton>
    <FluentLabel Margin="@Margin.Vertical4">
        Current count: @currentCount
    </FluentLabel>
</FluentStack>

@code {
    private int currentCount = 0;

    private async Task IncrementCountAsync()
    {
        currentCount++;
        await DialogService.ShowInfoAsync("Counter Incremented");
    }
}