@* spec: specs/features/theme-switching.md *@
@inherits LayoutComponentBase

<FluentLayout GlobalScrollbar="true">
    <FluentLayoutItem Area="LayoutArea.Header" Class="app-header">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Class="app-header-stack">
            <FluentText As="TextTag.H1" Size="TextSize.Size500" Weight="TextWeight.Semibold" Nowrap="true">
                MMG Explorer
            </FluentText>
            <FluentSpacer />
            <ThemeSwitcher />
        </FluentStack>
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Content">
        @Body
    </FluentLayoutItem>
</FluentLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@* Add all FluentUI Blazor Providers *@
<FluentProviders />
