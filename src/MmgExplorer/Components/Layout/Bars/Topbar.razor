@inject IJSRuntime JS

<FluentHeader Class="topbar">
    <FluentButton Appearance="ButtonAppearance.Default"
                  IconStart="@(new Icons.Regular.Size24.Navigation())"
                  OnClick="OnMenuToggle"
                  Class="topbar-menu-btn topbar-control-ghost"
                  Title="Toggle navigation" />

    <div class="topbar-brand">
        <div class="topbar-brand-mark">
            <FluentIcon Value="@(new Icons.Filled.Size24.Sparkle())"
                        Color="Color.Custom"
                        CustomColor="var(--global-color-aqua-70)" />
        </div>
        <div class="topbar-brand-text">
            <span class="topbar-brand-name">MMG Explorer</span>
            <span class="topbar-brand-tag">&nbsp;</span>
        </div>
    </div>

    <FluentSpacer />

    <div class="topbar-search">
        <FluentTextField Placeholder="Search projects, specs, docs..."
                         Class="topbar-search-field" />
    </div>

    <FluentSpacer />

    <div class="topbar-actions">
        <FluentButton Appearance="ButtonAppearance.Default"
                      IconStart="@ThemeIcon"
                      OnClick="ToggleTheme"
                      Class="topbar-control-ghost"
                      Title="@ThemeTitle" />
        <FluentButton Appearance="ButtonAppearance.Default"
                      IconStart="@(new Icons.Regular.Size20.QuestionCircle())"
                      Class="topbar-control-ghost"
                      Title="Help" />
        <div class="topbar-bell">
            <FluentButton Appearance="ButtonAppearance.Default"
                          IconStart="@(new Icons.Regular.Size20.Alert())"
                          Class="topbar-control-ghost"
                          Title="Notifications" />
            <span class="topbar-bell-dot"></span>
        </div>
        <div class="topbar-divider"></div>
        <button class="topbar-persona" title="Persona Here" aria-label="Account">
            <span class="topbar-persona-avatar">PH</span>
            <span class="topbar-persona-presence" aria-hidden="true"></span>
        </button>
    </div>
</FluentHeader>

@code {
    [Parameter] public EventCallback OnMenuToggle { get; set; }

    private bool _isDark;

    private Icon ThemeIcon => _isDark
        ? new Icons.Regular.Size20.WeatherSunny()
        : new Icons.Regular.Size20.WeatherMoon();

    private string ThemeTitle => _isDark ? "Switch to light mode" : "Switch to dark mode";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JS.InvokeAsync<string>("themeToggle.current");
                _isDark = theme == "dark";
                StateHasChanged();
            }
            catch { /* themeToggle script not ready yet — fine, it'll sync on first click */ }
        }
    }

    private async Task ToggleTheme()
    {
        try
        {
            var newTheme = await JS.InvokeAsync<string>("themeToggle.toggle");
            _isDark = newTheme == "dark";
        }
        catch
        {
            // Fallback: flip our local state and try set
            _isDark = !_isDark;
            await JS.InvokeVoidAsync("themeToggle.set", _isDark ? "dark" : "light");
        }
    }
}
